# 控制面 API 密钥；必须改成随机长字符串
SAFETY_API_KEY=change-me-to-a-long-random-string

# API 对外端口
SAFETY_API_PORT=18080

# Webhook HMAC 密钥；留空则不签名
SAFETY_WEBHOOK_SECRET=

# ICC RTSP 地址模板。支持 {device_code} / {channel_no} / {camera_id}
# 例如：rtsp://icc.example.com:554/{device_code}/{channel_no}
# 不确定就留空，创建摄像头时直接传 rtsp_url。
SAFETY_ICC_RTSP_TEMPLATE=

# 一次配置变更等待检测管线就绪的最长秒数
SAFETY_APPLY_TIMEOUT=90

# 仅本地调试用：1 = 不校验 API Key（生产必须为 0）
SAFETY_API_ALLOW_NO_AUTH=0
